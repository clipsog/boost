ZEFAME_API_KEY=your_api_key_here
BOOSTERO_API_KEY=your_boostero_api_key_here
FLASK_DEBUG=0
PORT=5050

ZEFAME_VIEWS_SERVICE=953
# Likes panel: auto (Zefame if site+API OK, else Boostero), zefame, boostero
LIKES_PANEL=auto
# Optional: Zefame site JS that lists ZFM_MAINT.ids (same as zefame.com/services)
# ZEFAME_MAINTENANCE_JS_URL=https://storage.perfectcdn.com/rx634k/0603lai24ssymyjt.js
BOOSTERO_LIKES_SERVICE=4802
# Legacy Zefame likes service (not used when Boostero is configured):
ZEFAME_LIKES_SERVICE=988
ZEFAME_QUEUE_PROFILE=the.clips.og
ZEFAME_QUEUE_LOOKBACK_HOURS=24
ZEFAME_QUEUE_MIN_AGE_HOURS=1

# Boost history (optional)
# BOOST_HISTORY_PATH=/var/data/boosted_videos.json
# BOOST_HISTORY_SEED_PATH=data/boost_history_seed.json
# BOOST_ADMIN_SECRET=choose-a-long-random-secret

# Optional: yt-dlp browser impersonation for TikTok profile queue
# YTDLP_IMPERSONATE=chrome-133,chrome-131
